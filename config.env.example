# Copy to config.env and edit. Environment variables override these values.

# Path to the picoclaw binary (it reads ~/.picoclaw/config.json as usual).
PICOCLAW_BIN=~/picoclaw
# Conversation memory key; change it to start a fresh conversation.
PICOCLAW_SESSION=aiy:voice

# Text-to-speech (edge-tts)
TTS_VOICE=zh-CN-YunxiaNeural
TTS_RATE=+0%

# Speech-to-text (Breeze-ASR-25 Hugging Face Space, via its Gradio API)
STT_SPACE_URL=https://wizardforest-breeze-asr-25-gui.hf.space
# Leave empty to auto-detect the endpoint (python3 breeze_stt.py --info lists them).
STT_API_NAME=
# Which of the Space's outputs is the transcript; empty = auto (skips status text
# like "轉錄完成"). `python3 breeze_stt.py --raw rec.wav` shows all outputs.
STT_OUTPUT_INDEX=
# Optional: a free HF token raises your quota on busy / ZeroGPU Spaces.
HF_TOKEN=

# First bot turn: "fixed" speaks GREETING (cached, instant); "llm" asks picoclaw for one.
GREETING_MODE=fixed
GREETING=你好，我是小龍蝦。請在嗶聲後說話，說完再按一次按鈕。
GREETING_PROMPT=有人按下了語音盒的按鈕。請用一句簡短、口語的繁體中文打招呼，並邀請對方說話。
# Appended to what you said, so the model answers in a speakable way.
REPLY_HINT=（這是語音對話：請用繁體中文口語、簡短地回答，兩三句話以內，不要使用 markdown、列表或表情符號。）

# Recording
ARECORD_DEVICE=default
MAX_RECORD_SEC=15
# Recordings whose peak level is below this (in % of full scale) count as silence.
MIN_PEAK_PERCENT=3
# Raise quiet recordings to a normal level before STT (1 = on).
NORMALIZE=1
BEEP=1

# Button and button-LED pins (BCM), used when the aiy Python library is not installed.
# Voice Kit v1 (Voice HAT): button 23, LED 25. Leave BUTTON_LED_GPIO empty for no LED.
BUTTON_GPIO=23
BUTTON_LED_GPIO=25
